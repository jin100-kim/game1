<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="gameplay-hud-screen" class="gameplay-hud-screen">
        <ui:VisualElement class="gameplay-hud-root">
            <ui:VisualElement class="hud-card gameplay-health-card">
                <ui:Label name="health-text" class="hud-card-text hud-health-text" text="체력" />
            </ui:VisualElement>

            <ui:VisualElement class="hud-card gameplay-xp-card">
                <ui:Label name="xp-text" class="hud-card-text" text="경험치" />
            </ui:VisualElement>

            <ui:VisualElement class="hud-card gameplay-time-card">
                <ui:Label name="time-text" class="hud-card-text" text="시간" />
            </ui:VisualElement>

            <ui:VisualElement name="mode-hint-card" class="hud-card gameplay-mode-card">
                <ui:Label name="mode-hint-text" class="hud-mode-text" text="" />
            </ui:VisualElement>

            <ui:VisualElement name="wave-status-card" class="hud-card gameplay-wave-status-card">
                <ui:Label name="wave-status-text" class="hud-center-text" text="" />
            </ui:VisualElement>

            <ui:VisualElement name="wave-banner-card" class="hud-card gameplay-wave-banner-card">
                <ui:Label name="wave-banner-text" class="hud-banner-text" text="" />
            </ui:VisualElement>

            <ui:VisualElement name="weapon-strip" class="gameplay-weapon-strip">
                <ui:VisualElement name="weapon-slot-0" class="gameplay-weapon-slot">
                    <ui:VisualElement name="weapon-icon-0" class="gameplay-weapon-icon" />
                    <ui:Label name="weapon-level-0" class="gameplay-weapon-level" text="-" />
                </ui:VisualElement>
                <ui:VisualElement name="weapon-slot-1" class="gameplay-weapon-slot">
                    <ui:VisualElement name="weapon-icon-1" class="gameplay-weapon-icon" />
                    <ui:Label name="weapon-level-1" class="gameplay-weapon-level" text="-" />
                </ui:VisualElement>
                <ui:VisualElement name="weapon-slot-2" class="gameplay-weapon-slot">
                    <ui:VisualElement name="weapon-icon-2" class="gameplay-weapon-icon" />
                    <ui:Label name="weapon-level-2" class="gameplay-weapon-level" text="-" />
                </ui:VisualElement>
                <ui:VisualElement name="weapon-slot-3" class="gameplay-weapon-slot">
                    <ui:VisualElement name="weapon-icon-3" class="gameplay-weapon-icon" />
                    <ui:Label name="weapon-level-3" class="gameplay-weapon-level" text="-" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="boss-bar-panel" class="gameplay-boss-panel">
                <ui:Label name="boss-name-text" class="gameplay-boss-name" text="보스" />

                <ui:VisualElement class="gameplay-boss-track">
                    <ui:VisualElement name="boss-bar-fill" class="gameplay-boss-fill" />
                </ui:VisualElement>

                <ui:Label name="boss-bar-value-text" class="gameplay-boss-value" text="0/0" />
            </ui:VisualElement>

            <ui:VisualElement name="direction-layer" class="gameplay-direction-layer" />

            <ui:VisualElement name="level-up-panel" class="modal-screen gameplay-levelup-screen">
                <ui:VisualElement class="modal-shell gameplay-levelup-shell">
                    <ui:Label name="level-up-title" class="modal-title" text="레벨 업" />

                    <ui:Button name="level-option-button-0" class="modal-option-button" text="" />
                    <ui:Button name="level-option-button-1" class="modal-option-button" text="" />
                    <ui:Button name="level-option-button-2" class="modal-option-button" text="" />
                    <ui:Button name="level-option-button-3" class="modal-option-button" text="" />
                    <ui:Button name="level-option-button-4" class="modal-option-button" text="" />
                    <ui:Button name="level-option-button-5" class="modal-option-button" text="" />
                    <ui:Button name="level-option-button-6" class="modal-option-button" text="" />
                    <ui:Button name="level-option-button-7" class="modal-option-button" text="" />
                    <ui:Button name="level-option-button-8" class="modal-option-button" text="" />
                    <ui:Button name="level-option-button-9" class="modal-option-button" text="" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="result-panel" class="modal-screen gameplay-result-screen">
                <ui:VisualElement class="modal-shell gameplay-result-shell">
                    <ui:Label class="modal-title" text="결과" />

                    <ui:VisualElement class="gameplay-result-card">
                        <ui:ScrollView mode="Vertical" name="result-scroll" class="gameplay-result-scroll">
                            <ui:Label name="result-text" class="gameplay-result-text" text="결과" />
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <ui:Button name="result-action-button" class="modal-action-button" text="타이틀로" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button name="debug-access-button" class="dev-corner-button gameplay-debug-access" text="DEV" />

            <ui:VisualElement name="debug-tools-panel" class="dev-panel-shell gameplay-debug-panel">
                <ui:Label class="dev-panel-title gameplay-debug-title" text="디버그 도구" />
                <ui:Button name="debug-grant-level-button" class="dev-panel-button gameplay-debug-button" text="레벨 +1" />
                <ui:Button name="debug-advance-time-button" class="dev-panel-button gameplay-debug-button" text="레벨 +5" />
                <ui:Button name="debug-reroll-button" class="dev-panel-button gameplay-debug-button" text="선택지 다시 굴리기" />
                <ui:Button name="debug-wave1-button" class="dev-panel-button gameplay-debug-button" text="엘리트1" />
                <ui:Button name="debug-wave2-button" class="dev-panel-button gameplay-debug-button" text="엘리트2" />
                <ui:Button name="debug-skip-boss-button" class="dev-panel-button gameplay-debug-button" text="보스" />
                <ui:Button name="debug-speed-button" class="dev-panel-button gameplay-debug-button" text="속도: 1x" />
                <ui:Button name="debug-invincible-button" class="dev-panel-button gameplay-debug-button" text="무적: 꺼짐" />
                <ui:Button name="debug-autoplay-button" class="dev-panel-button gameplay-debug-button" text="자동 전투: 꺼짐" />

                <ui:VisualElement name="monster-lab-section" class="dev-subsection">
                    <ui:Label class="dev-subsection-title" text="Monster Lab" />
                    <ui:Toggle name="monster-lab-toggle" text="실험실 모드" />
                    <ui:DropdownField name="monster-lab-dropdown" label="변종" />
                    <ui:Button name="monster-lab-spawn-one-button" class="dev-panel-button gameplay-debug-button" text="1마리 생성" />
                    <ui:Button name="monster-lab-spawn-five-button" class="dev-panel-button gameplay-debug-button" text="5마리 생성" />
                    <ui:Button name="monster-lab-clear-button" class="dev-panel-button gameplay-debug-button" text="전체 제거" />
                    <ui:Button name="monster-lab-pause-button" class="dev-panel-button gameplay-debug-button" text="시간 정지" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
