.pause-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.pause-overlay {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 32px;
    padding-bottom: 32px;
    background-color: rgba(0, 0, 0, 0.18);
}

.pause-shell {
    width: 560px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 30px;
    padding-bottom: 28px;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.55);
    border-right-color: rgba(87, 105, 128, 0.55);
    border-top-color: rgba(87, 105, 128, 0.55);
    border-bottom-color: rgba(87, 105, 128, 0.55);
    background-color: rgba(14, 20, 28, 0.97);
}

.pause-main-view {
    align-items: stretch;
}

.pause-title {
    color: rgb(242, 196, 53);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.pause-subtitle {
    color: rgb(190, 201, 214);
    font-size: 15px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 26px;
}

.pause-button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 14px;
}

.pause-button {
    flex-grow: 1;
    height: 56px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.7);
    border-right-color: rgba(87, 105, 128, 0.7);
    border-top-color: rgba(87, 105, 128, 0.7);
    border-bottom-color: rgba(87, 105, 128, 0.7);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgba(20, 28, 38, 0.96);
    color: rgb(238, 242, 249);
    font-size: 18px;
    -unity-font-style: bold;
}

.pause-button-left {
    margin-right: 8px;
}

.pause-button-right {
    margin-left: 8px;
}

.pause-button:hover {
    background-color: rgba(32, 42, 56, 0.98);
}

.pause-button-danger {
    background-color: rgba(79, 38, 46, 0.98);
}

.pause-button-danger:hover {
    background-color: rgba(101, 50, 60, 1);
}
