.dev-corner-button {
    position: absolute;
    left: 18px;
    bottom: 18px;
    width: 112px;
    height: 42px;
    display: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.7);
    border-right-color: rgba(87, 105, 128, 0.7);
    border-top-color: rgba(87, 105, 128, 0.7);
    border-bottom-color: rgba(87, 105, 128, 0.7);
    background-color: rgba(20, 28, 38, 0.98);
    color: rgb(242, 196, 53);
    font-size: 15px;
    -unity-font-style: bold;
}

.dev-panel-shell {
    position: absolute;
    left: 18px;
    bottom: 70px;
    width: 344px;
    display: none;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 18px;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.55);
    border-right-color: rgba(87, 105, 128, 0.55);
    border-top-color: rgba(87, 105, 128, 0.55);
    border-bottom-color: rgba(87, 105, 128, 0.55);
    background-color: rgba(14, 20, 28, 0.96);
}

.dev-panel-title {
    color: rgb(242, 196, 53);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.dev-panel-note {
    color: rgb(194, 207, 224);
    font-size: 14px;
    margin-bottom: 8px;
    white-space: normal;
}

.dev-panel-section {
    margin-top: 6px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(87, 105, 128, 0.45);
}

.dev-panel-section-title {
    margin-bottom: 10px;
    color: rgb(201, 214, 232);
    font-size: 14px;
    -unity-font-style: bold;
}

.dev-panel-button {
    height: 40px;
    margin-bottom: 10px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.6);
    border-right-color: rgba(87, 105, 128, 0.6);
    border-top-color: rgba(87, 105, 128, 0.6);
    border-bottom-color: rgba(87, 105, 128, 0.6);
    background-color: rgba(24, 34, 46, 0.98);
    color: rgb(238, 242, 249);
    font-size: 15px;
    -unity-font-style: bold;
}
