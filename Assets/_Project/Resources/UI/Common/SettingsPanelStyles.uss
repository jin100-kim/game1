.settings-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.settings-overlay {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 32px;
    padding-bottom: 32px;
    background-color: rgba(0, 0, 0, 0);
}

.settings-shell {
    width: 500px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 28px;
    padding-bottom: 26px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.62);
    border-right-color: rgba(87, 105, 128, 0.62);
    border-top-color: rgba(87, 105, 128, 0.62);
    border-bottom-color: rgba(87, 105, 128, 0.62);
    background-color: rgba(14, 20, 28, 0.96);
}

.settings-title {
    color: rgb(242, 196, 53);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.settings-card {
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 18px;
    margin-bottom: 16px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.28);
    border-right-color: rgba(87, 105, 128, 0.28);
    border-top-color: rgba(87, 105, 128, 0.28);
    border-bottom-color: rgba(87, 105, 128, 0.28);
    background-color: rgba(24, 34, 46, 0.92);
}

.settings-section-title {
    color: rgb(242, 196, 53);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    -unity-text-align: middle-left;
}

.settings-toggle {
    min-height: 32px;
    align-items: center;
}

.settings-toggle .unity-toggle__label {
    color: rgb(236, 241, 248);
    font-size: 17px;
    -unity-font-style: bold;
    margin-right: 12px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    margin-top: 12px;
}

.settings-row-label {
    width: 74px;
    color: rgb(236, 241, 248);
    font-size: 16px;
    -unity-font-style: bold;
}

.settings-slider {
    flex-grow: 1;
    margin-left: 14px;
    margin-right: 12px;
}

.settings-value {
    width: 48px;
    color: rgb(178, 191, 207);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.settings-back-button {
    align-self: center;
    width: 220px;
    height: 46px;
    margin-top: 4px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.7);
    border-right-color: rgba(87, 105, 128, 0.7);
    border-top-color: rgba(87, 105, 128, 0.7);
    border-bottom-color: rgba(87, 105, 128, 0.7);
    background-color: rgba(10, 15, 24, 0.98);
    color: rgb(240, 244, 250);
    font-size: 18px;
    -unity-font-style: bold;
}

.settings-back-button:hover {
    background-color: rgba(18, 25, 37, 1);
}
