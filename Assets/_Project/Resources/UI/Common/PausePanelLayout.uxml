<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="pause-screen" class="pause-screen">
        <ui:VisualElement class="pause-overlay">
            <ui:VisualElement class="pause-shell">
                <ui:VisualElement name="pause-main-view" class="pause-main-view">
                    <ui:Label class="pause-title" text="일시 정지" />
                    <ui:Label class="pause-subtitle" text="전투를 계속하거나 설정을 바꾼 뒤 타이틀로 돌아갈 수 있습니다." />

                    <ui:VisualElement class="pause-button-row">
                        <ui:Button name="pause-resume-button" class="pause-button" text="계속하기" />
                        <ui:Button name="pause-settings-button" class="pause-button" text="설정" />
                    </ui:VisualElement>

                    <ui:Button name="pause-quit-button" class="pause-button pause-button-danger" text="타이틀로" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
