.gameplay-hud-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.gameplay-hud-root {
    flex-grow: 1;
}

.hud-card {
    position: absolute;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.55);
    border-right-color: rgba(87, 105, 128, 0.55);
    border-top-color: rgba(87, 105, 128, 0.55);
    border-bottom-color: rgba(87, 105, 128, 0.55);
    background-color: rgba(14, 20, 28, 0.92);
}

.hud-card-text {
    color: rgb(240, 244, 250);
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.hud-health-text {
    font-size: 21px;
}

.gameplay-health-card {
    left: 24px;
    top: 24px;
    width: 250px;
    height: 72px;
}

.gameplay-xp-card {
    left: 290px;
    top: 24px;
    width: 334px;
    height: 72px;
}

.gameplay-time-card {
    left: 1678px;
    top: 24px;
    width: 218px;
    height: 72px;
}

.gameplay-mode-card {
    left: 1452px;
    top: 24px;
    width: 212px;
    height: 72px;
    display: none;
}

.hud-mode-text {
    color: rgb(194, 207, 224);
    font-size: 15px;
    -unity-text-align: middle-center;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.gameplay-wave-status-card {
    left: 810px;
    top: 24px;
    width: 300px;
    height: 60px;
    display: none;
}

.gameplay-wave-banner-card {
    left: 780px;
    top: 94px;
    width: 360px;
    height: 54px;
    background-color: rgba(18, 26, 38, 0.96);
    display: none;
}

.hud-center-text {
    color: rgb(244, 247, 252);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-top: 14px;
}

.hud-banner-text {
    color: rgb(255, 236, 107);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    white-space: normal;
}

.hud-button {
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.7);
    border-right-color: rgba(87, 105, 128, 0.7);
    border-top-color: rgba(87, 105, 128, 0.7);
    border-bottom-color: rgba(87, 105, 128, 0.7);
    background-color: rgba(20, 28, 38, 0.96);
    color: rgb(238, 242, 249);
    font-size: 18px;
    -unity-font-style: bold;
}

.hud-button:hover {
    background-color: rgba(32, 42, 56, 0.98);
}

.gameplay-build-toggle {
    position: absolute;
    left: 24px;
    top: 112px;
    width: 132px;
    height: 46px;
}

.gameplay-build-panel {
    position: absolute;
    left: 24px;
    top: 168px;
    width: 342px;
    height: 402px;
    display: none;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.55);
    border-right-color: rgba(87, 105, 128, 0.55);
    border-top-color: rgba(87, 105, 128, 0.55);
    border-bottom-color: rgba(87, 105, 128, 0.55);
    background-color: rgba(14, 20, 28, 0.92);
}

.gameplay-panel-title {
    color: rgb(242, 196, 53);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 18px;
    margin-bottom: 16px;
}

.gameplay-build-card {
    margin-left: 18px;
    margin-right: 18px;
    margin-bottom: 16px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 16px;
    padding-bottom: 16px;
    height: 148px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgba(24, 34, 46, 0.96);
}

.gameplay-build-card-bottom {
    height: 170px;
}

.gameplay-build-card-title {
    color: rgb(188, 201, 219);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.gameplay-build-body {
    color: rgb(236, 240, 247);
    font-size: 14px;
    white-space: normal;
}

.gameplay-boss-panel {
    position: absolute;
    left: 540px;
    top: 110px;
    width: 840px;
    height: 68px;
    display: none;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.55);
    border-right-color: rgba(87, 105, 128, 0.55);
    border-top-color: rgba(87, 105, 128, 0.55);
    border-bottom-color: rgba(87, 105, 128, 0.55);
    background-color: rgba(16, 24, 36, 0.92);
}

.gameplay-boss-name {
    position: absolute;
    left: 24px;
    top: 20px;
    width: 180px;
    color: rgb(242, 196, 53);
    font-size: 19px;
    -unity-font-style: bold;
}

.gameplay-boss-track {
    position: absolute;
    left: 240px;
    top: 23px;
    width: 470px;
    height: 22px;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    background-color: rgba(48, 52, 61, 0.98);
    overflow: hidden;
}

.gameplay-boss-fill {
    width: 100%;
    height: 100%;
    background-color: rgba(228, 46, 61, 0.95);
}

.gameplay-boss-value {
    position: absolute;
    right: 24px;
    top: 22px;
    width: 120px;
    color: rgb(236, 240, 247);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.gameplay-direction-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

.direction-indicator {
    position: absolute;
    width: 66px;
    height: 66px;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-top: 12px;
}

.direction-indicator-boss {
    background-color: rgba(30, 6, 10, 0.82);
    color: rgb(255, 84, 95);
}

.direction-indicator-wave {
    background-color: rgba(44, 16, 16, 0.78);
    color: rgb(255, 226, 226);
}

.direction-indicator-reward {
    background-color: rgba(7, 36, 18, 0.82);
    color: rgb(122, 255, 142);
}

.modal-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.24);
}

.modal-shell {
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.55);
    border-right-color: rgba(87, 105, 128, 0.55);
    border-top-color: rgba(87, 105, 128, 0.55);
    border-bottom-color: rgba(87, 105, 128, 0.55);
    background-color: rgba(14, 20, 28, 0.97);
}

.modal-title {
    color: rgb(242, 196, 53);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 22px;
}

.gameplay-levelup-shell {
    width: 860px;
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 34px;
    padding-bottom: 34px;
}

.modal-option-button {
    height: 68px;
    margin-bottom: 14px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.7);
    border-right-color: rgba(87, 105, 128, 0.7);
    border-top-color: rgba(87, 105, 128, 0.7);
    border-bottom-color: rgba(87, 105, 128, 0.7);
    background-color: rgba(24, 34, 46, 0.98);
    color: rgb(242, 246, 252);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 22px;
    padding-right: 22px;
}

.modal-option-button:hover {
    background-color: rgba(35, 48, 66, 0.98);
}

.gameplay-result-shell {
    width: 900px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 28px;
    padding-bottom: 28px;
}

.gameplay-result-card {
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 18px;
    padding-bottom: 18px;
    margin-bottom: 22px;
    min-height: 486px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgba(24, 34, 46, 0.98);
}

.gameplay-result-scroll {
    height: 430px;
}

.gameplay-result-text {
    color: rgb(238, 242, 249);
    font-size: 17px;
    white-space: normal;
}

.modal-action-button {
    align-self: center;
    width: 292px;
    height: 56px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.7);
    border-right-color: rgba(87, 105, 128, 0.7);
    border-top-color: rgba(87, 105, 128, 0.7);
    border-bottom-color: rgba(87, 105, 128, 0.7);
    background-color: rgba(20, 28, 38, 0.96);
    color: rgb(238, 242, 249);
    font-size: 18px;
    -unity-font-style: bold;
}

.modal-action-button:hover {
    background-color: rgba(32, 42, 56, 0.98);
}

.gameplay-debug-access {
    position: absolute;
    left: 18px;
    bottom: 18px;
    width: 72px;
    height: 38px;
    display: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgba(20, 28, 38, 0.96);
    color: rgb(238, 242, 249);
    -unity-font-style: bold;
}

.gameplay-debug-panel {
    position: absolute;
    left: 18px;
    bottom: 68px;
    width: 328px;
    display: none;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 18px;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    background-color: rgba(14, 20, 28, 0.96);
}

.gameplay-debug-title {
    font-size: 18px;
    margin-top: 0;
}

.gameplay-debug-button {
    height: 40px;
    margin-bottom: 10px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgba(24, 34, 46, 0.98);
    color: rgb(238, 242, 249);
}
