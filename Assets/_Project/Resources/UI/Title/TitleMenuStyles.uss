.title-root {
    flex-grow: 1;
    background-color: rgb(13, 20, 30);
}

.title-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.title-overlay-screen {
    display: none;
    align-items: center;
    justify-content: center;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 36px;
    padding-bottom: 72px;
}

.title-main-shell {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding-left: 96px;
    padding-right: 96px;
    padding-top: 72px;
    padding-bottom: 112px;
}

.title-overview-column {
    width: 540px;
    margin-right: 48px;
}

.title-action-column {
    width: 368px;
    min-height: 560px;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 26px;
    padding-bottom: 26px;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.7);
    border-right-color: rgba(87, 105, 128, 0.7);
    border-top-color: rgba(87, 105, 128, 0.7);
    border-bottom-color: rgba(87, 105, 128, 0.7);
    background-color: rgba(14, 20, 28, 0.96);
}

.title-kicker {
    color: rgb(242, 246, 252);
    font-size: 36px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.title-subtitle {
    color: rgb(188, 203, 222);
    font-size: 18px;
    margin-bottom: 26px;
    white-space: normal;
}

.title-panel-shell {
    width: 1180px;
    min-height: 760px;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 30px;
    padding-bottom: 26px;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.72);
    border-right-color: rgba(87, 105, 128, 0.72);
    border-top-color: rgba(87, 105, 128, 0.72);
    border-bottom-color: rgba(87, 105, 128, 0.72);
    background-color: rgba(14, 20, 28, 0.97);
}

.title-medium-shell {
    width: 940px;
    min-height: 560px;
}

.title-wide-shell {
    width: 1240px;
    min-height: 800px;
}

.title-panel-title {
    color: rgb(242, 196, 53);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.title-panel-subtitle {
    color: rgb(194, 207, 224);
    font-size: 15px;
    margin-bottom: 22px;
    white-space: normal;
}

.title-card {
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 16px;
    padding-bottom: 16px;
    margin-bottom: 18px;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    background-color: rgba(20, 30, 42, 0.98);
}

.title-column-card {
    width: 412px;
    flex-grow: 1;
}

.title-summary-card {
    margin-bottom: 14px;
}

.title-section-title {
    color: rgb(242, 196, 53);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.title-subsection-title {
    color: rgb(194, 207, 224);
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 8px;
}

.title-body-text {
    color: rgb(238, 242, 249);
    font-size: 16px;
    white-space: normal;
}

.title-body-text-scroll {
    white-space: normal;
}

.title-hero-text {
    color: rgb(242, 246, 252);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 18px;
    white-space: normal;
}

.title-character-name {
    color: rgb(242, 246, 252);
    margin-top: 6px;
}

.title-inline-note {
    color: rgb(182, 197, 216);
    font-size: 14px;
    margin-bottom: 10px;
    white-space: normal;
}

.title-inline-note-strong {
    color: rgb(242, 196, 53);
    -unity-font-style: bold;
}

.title-action-button {
    height: 58px;
    margin-bottom: 14px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgba(20, 28, 38, 0.98);
    color: rgb(238, 242, 249);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.title-action-button-primary {
    background-color: rgba(40, 64, 91, 0.98);
}

.title-action-button-subtle {
    background-color: rgba(10, 15, 22, 0.98);
    margin-top: 6px;
}

.title-footer-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
}

.title-footer-button {
    width: 248px;
    height: 50px;
    margin-left: 10px;
    margin-right: 10px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgba(40, 64, 91, 0.98);
    color: rgb(238, 242, 249);
    font-size: 17px;
    -unity-font-style: bold;
}

.title-footer-button-subtle {
    background-color: rgba(10, 15, 22, 0.98);
}

.title-tab-row {
    flex-direction: row;
    margin-bottom: 14px;
}

.title-tab-button {
    width: 172px;
    height: 42px;
    margin-right: 12px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgba(20, 28, 38, 0.98);
    color: rgb(238, 242, 249);
    font-size: 15px;
    -unity-font-style: bold;
}

.title-scroll {
    flex-grow: 1;
    background-color: rgba(8, 12, 19, 0.45);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.title-large-scroll {
    min-height: 560px;
    margin-bottom: 16px;
}

.title-two-column-row {
    flex-direction: row;
    justify-content: space-between;
}

.title-character-list-card {
    width: 640px;
    min-height: 620px;
    margin-right: 22px;
}

.title-character-detail-card {
    flex-grow: 1;
    min-height: 620px;
}

.title-step-root {
    flex-grow: 1;
}

.title-chip-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 14px;
}

.title-chip-button {
    min-width: 220px;
    height: 52px;
    margin-right: 14px;
    margin-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgba(20, 28, 38, 0.98);
    color: rgb(238, 242, 249);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
}

.title-chip-button.is-selected {
    background-color: rgba(52, 80, 114, 1);
}

.title-chip-button.is-locked {
    opacity: 0.55;
}

.title-list-entry {
    margin-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgba(20, 28, 38, 0.98);
}

.title-list-entry.is-selected {
    background-color: rgba(52, 80, 114, 1);
}

.title-list-entry.is-completed {
    background-color: rgba(18, 34, 40, 0.98);
}

.title-entry-title {
    color: rgb(242, 246, 252);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
}

.title-entry-subtitle {
    color: rgb(194, 207, 224);
    font-size: 13px;
    margin-top: 6px;
    white-space: normal;
}

.title-entry-status {
    color: rgb(242, 196, 53);
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 6px;
    white-space: normal;
}

.title-entry-status.is-completed {
    color: rgb(114, 224, 142);
}

.title-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.title-entry-action {
    width: 220px;
    height: 46px;
    margin-left: 18px;
}

.title-text-field {
    margin-top: 12px;
    margin-bottom: 16px;
}

.title-status-shell {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    align-items: center;
}

.title-status-line {
    min-width: 360px;
    max-width: 1120px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(9, 13, 20, 0.92);
    color: rgb(194, 207, 224);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.title-modal-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.34);
}

.title-modal-shell {
    width: 820px;
    min-height: 460px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 24px;
    padding-bottom: 24px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    background-color: rgba(14, 20, 28, 0.98);
}

.title-confirm-shell {
    width: 620px;
    min-height: 280px;
}

.title-modal-scroll {
    min-height: 280px;
    margin-bottom: 16px;
}

.title-confirm-text {
    min-height: 128px;
    margin-top: 18px;
    margin-bottom: 18px;
    -unity-text-align: middle-center;
}
