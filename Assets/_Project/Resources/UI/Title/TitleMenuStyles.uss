.screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 32px;
    padding-bottom: 32px;
    background-color: rgba(0, 0, 0, 0);
}

.menu-shell {
    width: 360px;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 30px;
    padding-bottom: 28px;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.55);
    border-right-color: rgba(87, 105, 128, 0.55);
    border-top-color: rgba(87, 105, 128, 0.55);
    border-bottom-color: rgba(87, 105, 128, 0.55);
    background-color: rgba(14, 20, 28, 0.96);
}

.menu-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(242, 246, 252);
    margin-bottom: 24px;
    -unity-text-align: middle-center;
}

.menu-button {
    height: 58px;
    margin-bottom: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(87, 105, 128, 0.7);
    border-right-color: rgba(87, 105, 128, 0.7);
    border-top-color: rgba(87, 105, 128, 0.7);
    border-bottom-color: rgba(87, 105, 128, 0.7);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgba(20, 28, 38, 0.96);
    color: rgb(238, 242, 249);
    font-size: 18px;
    -unity-font-style: bold;
}

.menu-button:hover {
    background-color: rgba(32, 42, 56, 0.98);
}

.menu-button:disabled {
    opacity: 0.45;
}

.menu-button.primary {
    background-color: rgba(40, 64, 91, 0.98);
}

.menu-button.primary:hover {
    background-color: rgba(51, 79, 112, 1);
}

.menu-button.subtle {
    margin-top: 6px;
    margin-bottom: 0;
    background-color: rgba(12, 17, 24, 0.92);
}
